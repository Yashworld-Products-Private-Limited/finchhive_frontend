{
  "name": "agency_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-sitemap.js && next build",
    "start": "npm run pull && npm run pages:build-and-dev",
    "lint": "eslint",
    "pages:dev": "wrangler pages dev",
    "pages:build-and-dev": "npx next build && wrangler pages dev",
    "r2:info": "wrangler r2 bucket info finchhive",
    "pull": "node --env-file-if-exists=.env scripts/r2-sync.mjs pull",
    "push": "node --env-file-if-exists=.env scripts/r2-sync.mjs push"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.2.6",
