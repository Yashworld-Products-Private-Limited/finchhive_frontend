    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "jquery": "^4.0.0",
    "jquery.ripples": "^0.6.3",
    "lenis": "^1.3.23",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.16.0",
    "matter-js": "^0.20.0",
    "motion": "^12.40.0",
    "next": "16.2.4",
    "ogl": "^1.0.11",
    "postcss": "^8.5.15",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-calendly": "^4.4.0",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
