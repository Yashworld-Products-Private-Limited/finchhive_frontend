# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# wrangler local dev state (local R2/KV emulation, logs)
.wrangler

# r2-assets/ is a local-only staging folder for `npm run push` (see
# r2-assets/README.md) — the R2 bucket is the source of truth for media,
# not this repo, so never commit real files dropped in there.
r2-assets/*
!r2-assets/README.md

# typescript
*.tsbuildinfo
next-env.d.ts

/public/api